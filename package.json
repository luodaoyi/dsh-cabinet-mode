{
  "name": "dsh-cabinet-mode",
  "version": "0.9.0",
  "description": "Cabinet Mode (内阁模式) for DeepSeek Harness: a declarative DSH bundle that adds a dual-identity Lead/teammate agent preset for the Great Ming Research Bureau cabinet team.",
  "license": "MIT",
  "icon": "./icon.svg",
  "private": false,
  "type": "module",
  "author": "luodaoyi",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luodaoyi/dsh-cabinet-mode.git"
  },
  "homepage": "https://github.com/luodaoyi/dsh-cabinet-mode#readme",
  "bugs": {
    "url": "https://github.com/luodaoyi/dsh-cabinet-mode/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "dsh-agent-preset",
    "cabinet-mode",
    "persona",
    "agent-team",
    "research-team"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/cross-platform.md",
    "docs/member-usage-validation.md",
    "docs/images",
    "scripts",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "market:index": "node scripts/market-index.mjs",
    "market:check": "node scripts/market-index.mjs --check",
    "market:publish": "bash scripts/publish-market-index.sh",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5",
    "@deepseek-ai/dsh-web-frontend": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
