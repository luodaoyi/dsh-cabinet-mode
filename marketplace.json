  "plugins": [
    {
      "name": "dsh-cabinet-mode",
      "title": {
        "en": "Cabinet Mode",
        "zh": "内阁模式"
      },
      "description": {
        "en": "Adds the “内阁模式” preset: one persona shared by the Lead and the bureau members (翰林院 / 工部 / 大理寺 / 都察院), research-first rules, and evidence-anchored reporting. Includes the Cabinet sidebar, member avatars and profile-wide settings with per-office model selection; since 0.3.0 it uses @deepseek-ai/schemastery for its settings schema.",
        "zh": "新增「内阁模式」preset：首辅与阁臣（翰林院 / 工部 / 大理寺 / 都察院）共享同一段 persona，默认只调研不改码、结论必须锚定证据。包含内阁侧边栏、成员头像与支持各官职独立模型选择的 profile 共享设置；自 0.3.0 起使用 @deepseek-ai/schemastery 作为设置 schema 依赖。"
      },
      "icon": "./icon.svg",
      "author": "luodaoyi",
      "homepage": "https://github.com/luodaoyi/dsh-cabinet-mode#readme",
